{
  "name": "quota-guru",
  "private": true,
  "version": "1.0.0",
  "description": "Quota Guru – comparatore di quote sportive (export React del progetto Figma Make \"Betting Affiliate Site UI\")",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/derive-football-home.mjs && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "data": "node scripts/fetch-football-data.mjs && node scripts/derive-football-home.mjs && node scripts/fetch-basket-data.mjs && node scripts/generate-editorial.mjs",
    "editorial": "node scripts/generate-editorial.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "0.487.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.55.0",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.3",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "4.1.3",
    "tw-animate-css": "^1.2.5",
    "typescript": "~5.7.3",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
